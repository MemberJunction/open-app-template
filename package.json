{
  "name": "open-app-template",
  "version": "0.0.0",
  "private": true,
  "license": "BUSL-1.1",
  "description": "Template repository for MemberJunction Open Apps - clone, rename, fill in. See README.md and docs/.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prebuild": "node -e \"try { require.resolve('turbo') } catch (e) { console.error('\\n[ERROR] Dependencies not installed. Run: pnpm install\\n'); process.exit(1); }\"",
    "init": "node scripts/init-template.mjs",
    "build": "pnpm run build:stream",
    "build:stream": "turbo --log-order=stream build",
    "build:packages": "turbo --log-order=stream build --filter=\"@mj-sample-app/*\"",
    "test": "turbo --log-order=stream test --filter=\"@mj-sample-app/*\"",
    "mj": "mj",
    "mj:migrate": "mj migrate --schema sample_app --dir ./migrations",
    "mj:codegen": "mj codegen",
    "mj:migrate:convert": "mj migrate convert --source-dir ./migrations --output-dir ./migrations-pg --schema sample_app",
    "change": "changeset",
    "version": "changeset version",
    "version:prepare": "changeset version && node ci/sync-mj-app-version.mjs && pnpm install --lockfile-only"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MemberJunction/open-app-template"
  },
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@angular/common": "21.1.3",
    "@angular/compiler": "21.1.3",
    "@angular/compiler-cli": "21.1.3",
    "@angular/core": "21.1.3",
    "@angular/forms": "21.1.3",
    "@changesets/cli": "^2.29.8",
    "@memberjunction/cli": "6.1.0-edge.3",
    "@memberjunction/core": "6.1.0-edge.3",
    "@memberjunction/core-entities": "6.1.0-edge.3",
    "@memberjunction/global": "6.1.0-edge.3",
    "@memberjunction/ng-base-forms": "6.1.0-edge.3",
    "@memberjunction/ng-entity-viewer": "6.1.0-edge.3",
    "@memberjunction/ng-link-directives": "6.1.0-edge.3",
    "@memberjunction/ng-shared": "6.1.0-edge.3",
    "@memberjunction/server": "6.1.0-edge.3",
    "@types/node": "^22.10.0",
    "simple-git": "^3.31.1",
    "tsc-alias": "^1.8.16",
    "turbo": "^2.7.3",
    "typescript": "^5.9.3",
    "zod": "^3.25.76"
  },
  "pnpm": {
    "overrides": {
      "@memberjunction/core": "6.1.0-edge.3",
      "@memberjunction/global": "6.1.0-edge.3"
    }
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=10.0.0"
  }
}
